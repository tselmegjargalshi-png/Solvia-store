# ---------------------------------------------------------------------------
# SOLVIA environment configuration. Copy to .env and adjust.
# NEVER commit a real .env. Secrets below are read only by the server and are
# never sent to the browser bundle.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=4173
# Public origin used for canonical URLs, sitemap, Open Graph and payment return URLs.
PUBLIC_URL=http://localhost:4173

# SQLite database file (created automatically).
DATABASE_PATH=data/solvia.db
# Where admin image uploads are written (served at /uploads/...).
UPLOAD_DIR=public/uploads

# Set to true when serving over HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false

# ---- Payments --------------------------------------------------------------
# demo   = clearly labelled simulated card payments; no money moves (default).
# stripe = Stripe Checkout. Requires BOTH keys below; otherwise demo is used.
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Demo payments are refused when NODE_ENV=production unless this is true (e.g. a public demo).
ALLOW_DEMO_PAYMENTS=false

# ---- Google ----------------------------------------------------------------
# GA4 measurement id, e.g. G-XXXXXXXXXX. Empty = no analytics script is loaded.
GA_MEASUREMENT_ID=
# Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# ---- Development helpers ---------------------------------------------------
# No email provider is wired yet: in development, password-reset links are printed to the server log.
LOG_RESET_LINKS=true
# Only for automated tests.
DISABLE_RATE_LIMIT=false

# ---- Initial administrator (optional, used by `npm run create-admin`) -------
# Prefer the interactive prompt. If you set these for automation, remove them afterwards.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
